{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/d/:key",
      "destination": "https://ugxzpmsotzfhoqraohvv.supabase.co/functions/v1/download?key=:key"
    },
    { "source": "/r/:key", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
