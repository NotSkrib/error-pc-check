<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ssac-screenshare</AssemblyName>
    <RootNamespace>SSAC.Client</RootNamespace>

    <!-- Version + publisher metadata: shows real info in the file's Properties
         and (once code-signed) in the SmartScreen / UAC publisher line.
         An unsigned build still triggers SmartScreen's "unrecognized app" —
         see docs/signing.md; this is the prep so signing is one step. -->
    <Version>0.4.0</Version>
    <FileVersion>0.4.0.0</FileVersion>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <Company>PC Integrity Tools</Company>
    <Product>PC Integrity Check</Product>
    <Authors>PC Integrity Tools</Authors>
    <AssemblyTitle>PC Integrity Check</AssemblyTitle>
    <Description>PC Integrity Check — a consented PC integrity check for Minecraft. The player runs it once with a staff-issued key; it reads Windows program-execution history and Minecraft folders, uploads a report to the panel that issued the key, and exits. No installation, no background service, no persistence.</Description>
    <Copyright>Copyright (c) 2026 Error SMP</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- single-file, self-contained publish target (see docs/phase-0-design.md §4.1 "Client self") -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\signatures\ssac-signatures.json" LogicalName="ssac-signatures.json" />
  </ItemGroup>

</Project>
