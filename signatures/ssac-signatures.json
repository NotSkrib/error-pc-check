  "note": "SSAC known-cheat signature seed DB (docs/phase-0-design.md §7). Matchers use publicly known names, package identifiers and log banners only. file_hash matchers are community-contributed and intentionally empty in the seed. A signature matches when the summed weight of its matched matchers >= min_confidence. The client uses whichever of (embedded copy, fetched copy) has the newer version and records the version used in every report.",
  "matcher_kinds": {
    "file_name_regex": "regex tested against each file name in mods/ and versions/",
    "log_regex": "regex tested against .minecraft/logs/*.log(.gz) contents",
    "string": "case-insensitive substring tested against jar entry names, config file names, and log text",
    "file_hash": "sha256 hex of a mod jar (exact build match)"
  },
