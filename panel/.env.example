# Copy to panel/.env.local and fill in.
# Local Supabase (from `supabase start` output):
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Where the `irm ... | iex` command points (the error-pc-check host).
# Optional — default is the Railway/Cloudflare Pages deployment.
# VITE_RUN_BASE=https://error-pc-check.example.dev
